@page "/"
@inject ProductApiService ProductService
@inject IJSRuntime JS

<PageTitle>InventoryHub | Inventory dashboard</PageTitle>

<div class="app-frame">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="InventoryHub home">
            <span class="brand-mark">I</span>
            <span>Inventory<span class="brand-light">Hub</span></span>
        </a>
        <div class="sidebar-label">WORKSPACE</div>
        <a class="side-link active" href="/">
            <span class="side-icon">▦</span> Inventory overview
        </a>
        <div class="sidebar-label sidebar-label-spaced">MANAGEMENT</div>
        <div class="side-link side-link-muted"><span class="side-icon">⇄</span> Stock movement <span class="soon-tag">SOON</span></div>
        <div class="side-link side-link-muted"><span class="side-icon">♧</span> Suppliers <span class="soon-tag">SOON</span></div>
        <div class="sidebar-bottom">
            <div class="api-status"><span class="status-dot"></span><span><strong>API connected</strong><small>InventoryHub service</small></span></div>
            <div class="user-mini"><div class="avatar">IH</div><div><strong>Workspace admin</strong><small>Demo workspace</small></div></div>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="breadcrumb"><span>Workspace</span><span class="crumb-slash">/</span><strong>Inventory</strong></div>
            <div class="topbar-right"><span class="live-label"><span class="status-dot"></span> Connected to API</span><span class="topbar-divider"></span><span class="date-label">INVENTORY MANAGEMENT</span></div>
        </header>

        <section class="page-content">
            <div class="page-heading">
                <div>
                    <div class="eyebrow">OPERATIONS / INVENTORY</div>
                    <h1>Inventory overview<span class="heading-period">.</span></h1>
                    <p class="page-subtitle">Track products, monitor stock levels, and keep your catalog in sync.</p>
                </div>
                <button class="button button-primary" @onclick="StartCreate"><span class="plus-mark">＋</span> Add product</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <div class="notice notice-success" role="status"><span>✓</span><span>@_notice</span><button class="notice-close" @onclick="() => _notice = null" aria-label="Dismiss notice">×</button></div>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="notice notice-error" role="alert"><span>!</span><span>@_error</span><button class="notice-close" @onclick="() => _error = null" aria-label="Dismiss error">×</button></div>
            }

            <section class="metrics-grid" aria-label="Inventory summary">
                <article class="metric-card"><div class="metric-top"><span class="metric-label">TOTAL PRODUCTS</span><span class="metric-icon icon-violet">▦</span></div><div class="metric-value">@_summary.TotalProducts.ToString("N0")</div><div class="metric-foot"><span class="metric-foot-dot dot-violet"></span>Across all categories</div></article>
                <article class="metric-card"><div class="metric-top"><span class="metric-label">LOW STOCK</span><span class="metric-icon icon-amber">⌁</span></div><div class="metric-value">@_summary.LowStockProducts</div><div class="metric-foot"><span class="metric-foot-dot dot-amber"></span>10 units or fewer</div></article>
                <article class="metric-card"><div class="metric-top"><span class="metric-label">OUT OF STOCK</span><span class="metric-icon icon-rose">⊘</span></div><div class="metric-value">@_summary.OutOfStockProducts</div><div class="metric-foot"><span class="metric-foot-dot dot-rose"></span>Requires replenishment</div></article>
                <article class="metric-card"><div class="metric-top"><span class="metric-label">IN STOCK VALUE</span><span class="metric-icon icon-green">$</span></div><div class="metric-value metric-value-money">@_summary.InventoryValue.ToString("C0", CultureInfo.GetCultureInfo("en-US"))</div><div class="metric-foot"><span class="metric-foot-dot dot-green"></span>Current catalog estimate</div></article>
            </section>

            @if (_showForm)
            {
                <section class="form-card" aria-labelledby="product-form-heading">
                    <div class="form-heading-row"><div><div class="eyebrow">PRODUCT DETAILS</div><h2 id="product-form-heading">@(_editingId.HasValue ? "Edit product" : "Add a product")</h2></div><button class="icon-button" @onclick="CloseForm" aria-label="Close form">×</button></div>
                    <EditForm Model="@_form" OnValidSubmit="@SaveAsync">
                        <DataAnnotationsValidator />
                        <div class="form-grid">
                            <div class="field"><label for="product-name">Product name</label><InputText id="product-name" @bind-Value="_form.Name" placeholder="e.g. Wireless Mouse" /><ValidationMessage For="() => _form.Name" /></div>
                            <div class="field"><label for="product-sku">SKU</label><InputText id="product-sku" @bind-Value="_form.Sku" placeholder="e.g. ACC-1004" /><ValidationMessage For="() => _form.Sku" /></div>
                            <div class="field"><label for="product-category">Category</label><InputText id="product-category" @bind-Value="_form.Category" placeholder="e.g. Accessories" /><ValidationMessage For="() => _form.Category" /></div>
                            <div class="field"><label for="product-supplier">Supplier</label><InputText id="product-supplier" @bind-Value="_form.Supplier" placeholder="Supplier company" /><ValidationMessage For="() => _form.Supplier" /></div>
                            <div class="field"><label for="product-price">Unit price (USD)</label><InputNumber id="product-price" @bind-Value="_form.Price" min="0.01" step="0.01" /><ValidationMessage For="() => _form.Price" /></div>
                            <div class="field"><label for="product-stock">Stock quantity</label><InputNumber id="product-stock" @bind-Value="_form.StockQuantity" min="0" /><ValidationMessage For="() => _form.StockQuantity" /></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_formError)) { <p class="form-error" role="alert">@_formError</p> }
                        <div class="form-actions"><button type="button" class="button button-quiet" @onclick="CloseForm">Cancel</button><button type="submit" class="button button-primary" disabled="@_isSaving">@(_isSaving ? "Saving…" : _editingId.HasValue ? "Save changes" : "Create product")</button></div>
                    </EditForm>
                </section>
            }

            <section class="inventory-card">
                <div class="inventory-card-header">
                    <div><h2>Product catalog</h2><p>Search and manage every item in your inventory.</p></div>
                    <div class="catalog-count"><span class="count-dot"></span>@_totalItems products</div>
                </div>
                <div class="toolbar">
                    <form class="search-box" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                        <span class="search-symbol">⌕</span><input aria-label="Search products" placeholder="Search name, SKU, or supplier…" @bind="_searchInput" @bind:event="oninput" /><button type="submit" class="search-submit" aria-label="Submit search">↵</button>
                    </form>
                    <div class="filter-box"><span class="filter-symbol">☷</span><select aria-label="Filter by category" value="@_category" @onchange="CategoryChanged"><option value="All">All categories</option>@foreach (var category in _categories) { <option value="@category">@category</option> }</select></div>
                    <button class="button button-quiet button-refresh" @onclick="ReloadAsync" disabled="@_isLoading"><span class="refresh-symbol">↻</span> Refresh</button>
                </div>

                @if (_isLoading)
                {
                    <div class="loading-state"><span class="spinner"></span><span>Loading inventory…</span></div>
                }
                else if (_products.Count == 0)
                {
                    <div class="empty-state"><span class="empty-icon">⌕</span><h3>No products found</h3><p>Try a different search or add a new product to the catalog.</p><button class="button button-primary" @onclick="StartCreate">Add product</button></div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="product-table">
                            <thead><tr><th>PRODUCT</th><th>SKU</th><th>CATEGORY</th><th>UNIT PRICE</th><th>STOCK LEVEL</th><th>SUPPLIER</th><th><span class="sr-only">Actions</span></th></tr></thead>
                            <tbody>
                                @foreach (var product in _products)
                                {
                                    <tr @key="product.ProductId">
                                        <td><div class="product-cell"><div class="product-avatar @ProductAvatarClass(product.Category)">@ProductInitials(product.Name)</div><div><strong>@product.Name</strong><small>Updated @product.UpdatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</small></div></div></td>
                                        <td><span class="sku-text">@product.Sku</span></td>
                                        <td><span class="category-pill">@product.Category</span></td>
                                        <td><strong class="price-text">@product.Price.ToString("C2", CultureInfo.GetCultureInfo("en-US"))</strong></td>
                                        <td><div class="stock-cell"><span class="stock-pill @StockClass(product.StockQuantity)"><span class="stock-pill-dot"></span>@StockLabel(product.StockQuantity)</span><small>@product.StockQuantity units</small></div></td>
                                        <td><span class="supplier-text">@product.Supplier</span></td>
                                        <td><div class="row-actions"><button class="row-action" @onclick="() => StartEdit(product)" aria-label="Edit @product.Name" title="Edit product">✎</button><button class="row-action row-action-delete" @onclick="() => DeleteAsync(product)" aria-label="Delete @product.Name" title="Delete product">×</button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer class="table-footer">
                        <span>Showing <strong>@ShowingStart–@ShowingEnd</strong> of <strong>@_totalItems</strong> products</span>
                        <div class="pagination"><button class="page-button" @onclick="PreviousPageAsync" disabled="@(_page <= 1 || _isLoading)" aria-label="Previous page">‹</button><span class="page-number">Page <strong>@_page</strong> of <strong>@_totalPages</strong></span><button class="page-button" @onclick="NextPageAsync" disabled="@(_page >= _totalPages || _isLoading)" aria-label="Next page">›</button></div>
                    </footer>
                }
            </section>
            <footer class="app-footer"><span>© 2026 InventoryHub</span><span><span class="footer-dot"></span> REST API · JSON · SQLite</span><span>Built for operational clarity.</span></footer>
        </section>
    </main>
</div>

@code {
    private List<Product> _products = new();
    private List<string> _categories = new();
    private string _searchInput = string.Empty;
    private string _searchText = string.Empty;
    private string _category = "All";
    private int _page = 1;
    private const int PageSize = 8;
    private int _totalItems;
    private int _totalPages = 1;
    private bool _isLoading;
    private bool _isSaving;
    private bool _showForm;
    private int? _editingId;
    private string? _error;
    private string? _notice;
    private string? _formError;
    private ProductFormModel _form = new();
    private InventorySummary _summary = new();
    private int ShowingStart => _totalItems == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int ShowingEnd => Math.Min(_page * PageSize, _totalItems);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await ProductService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load product categories. Check that the API is running. Details: {ex.Message}";
        }

        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var productsTask = ProductService.GetProductsAsync(_searchText, _category, _page, PageSize);
            var summaryTask = ProductService.GetSummaryAsync();
            await Task.WhenAll(productsTask, summaryTask);
            var response = await productsTask;
            _summary = await summaryTask;
            _products = response.Items;
            _totalItems = response.TotalItems;
            _totalPages = Math.Max(1, response.TotalPages);
            _page = response.Page;
        }
        catch (Exception ex)
        {
            _products.Clear();
            _totalItems = 0;
            _error = $"Unable to load inventory. Make sure the API is running at http://localhost:5080. Details: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        _searchText = _searchInput.Trim();
        _page = 1;
        await LoadProductsAsync();
    }

    private async Task CategoryChanged(ChangeEventArgs args)
    {
        _category = args.Value?.ToString() ?? "All";
        _page = 1;
        await LoadProductsAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _categories = await ProductService.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not refresh categories: {ex.Message}";
        }
        await LoadProductsAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadProductsAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= _totalPages) return;
        _page++;
        await LoadProductsAsync();
    }

    private void StartCreate()
    {
        _form = new ProductFormModel();
        _editingId = null;
        _formError = null;
        _showForm = true;
    }

    private void StartEdit(Product product)
    {
        _form = ProductFormModel.FromProduct(product);
        _editingId = product.ProductId;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _formError = null;
        _error = null;
        try
        {
            if (_editingId is int productId)
            {
                await ProductService.UpdateAsync(productId, _form);
                _notice = $"{_form.Name} was updated successfully.";
            }
            else
            {
                await ProductService.CreateAsync(_form);
                _notice = $"{_form.Name} was added to the inventory.";
            }
            _showForm = false;
            _categories = await ProductService.GetCategoriesAsync();
            _page = 1;
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync(Product product)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{product.Name}' ({product.Sku})? This action cannot be undone.");
        if (!confirmed) return;

        _error = null;
        try
        {
            await ProductService.DeleteAsync(product.ProductId);
            _notice = $"{product.Name} was deleted.";
            _categories = await ProductService.GetCategoriesAsync();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not delete product: {ex.Message}";
        }
    }

    private static string ProductInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}" : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private static string ProductAvatarClass(string category) => category.ToLowerInvariant() switch
    {
        "displays" => "avatar-blue",
        "audio" => "avatar-pink",
        "ergonomics" => "avatar-green",
        "networking" => "avatar-cyan",
        "storage" => "avatar-amber",
        "video" => "avatar-violet",
        _ => "avatar-slate"
    };

    private static string StockClass(int quantity) => quantity switch
    {
        0 => "stock-out",
        <= 10 => "stock-low",
        _ => "stock-healthy"
    };

    private static string StockLabel(int quantity) => quantity switch
    {
        0 => "Out of stock",
        <= 10 => "Low stock",
        _ => "In stock"
    };
}
